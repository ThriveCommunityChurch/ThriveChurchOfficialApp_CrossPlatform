{
  "name": "thrivechurchexpo",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "npx expo prebuild --clean",
    "prebuild:ios": "npx expo prebuild --clean --platform ios && node scripts/add-ios-splash-copyright.js && node scripts/patch-podfile-properties.js && cp GoogleService-Info.plist ios/ThriveChurchOfficialApp/ && cd ios && pod install",
    "prebuild:android": "npx expo prebuild --clean --platform android && node scripts/copy-android-splash.js",
    "generate:splash": "node scripts/generate-android-splash.js",
    "patch-podfile": "node scripts/patch-podfile-properties.js",
    "version:bump": "node scripts/increment-build.js",
    "version:patch": "node scripts/increment-build.js --bump-patch",
    "version:minor": "node scripts/increment-build.js --bump-minor",
    "version:major": "node scripts/increment-build.js --bump-major",
    "build:ios": "node scripts/increment-build.js && npm run prebuild:ios",
    "build:android": "node scripts/increment-build.js && npm run prebuild:android",
    "test:ui": "./scripts/run-ui-tests.sh all",
    "test:ui:ios": "./scripts/run-ui-tests.sh ios",
    "test:ui:android": "./scripts/run-ui-tests.sh android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.5.2",
    "@react-native-firebase/analytics": "^23.8.8",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/crashlytics": "^23.8.8",
    "@react-native-firebase/messaging": "^23.8.8",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@react-navigation/stack": "^7.10.17",
    "@shopify/flash-list": "^1.8.3",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.18.1",
    "expo": "~54.0.36",
    "expo-application": "^7.0.8",
    "expo-build-properties": "^1.0.10",
    "expo-calendar": "~15.0.8",
    "expo-constants": "^18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "^8.0.10",
    "expo-file-system": "^19.0.23",
    "expo-linear-gradient": "~15.0.8",
    "expo-localization": "~17.0.8",
    "expo-sharing": "^14.0.8",
    "expo-splash-screen": "^31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "^6.0.9",
    "i18next": "^25.6.0",
    "react": "19.1.0",
    "react-i18next": "^16.2.3",
    "react-native": "0.81.4",
    "react-native-audio-analyzer": "^3.1.0",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-nitro-modules": "^0.29.8",
    "react-native-rss-parser": "^1.5.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.26.2",
    "react-native-share": "^12.3.1",
    "react-native-track-player": "^5.0.0-alpha0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-webview": "^13.17.0",
    "react-native-youtube-iframe": "^2.4.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "^19.2.17",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
