{
  "name": "thrivechurchexpo",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@10.34.0",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "npx expo prebuild --clean",
    "prebuild:ios": "npx expo prebuild --clean --platform ios && node scripts/add-ios-splash-copyright.js && cp GoogleService-Info.plist ios/ThriveChurchOfficialApp/ && cd ios && pod install",
    "prebuild:android": "npx expo prebuild --clean --platform android && node scripts/copy-android-splash.js",
    "prebuild:ci": "expo prebuild --clean --no-install && node scripts/add-ios-splash-copyright.js && node scripts/copy-android-splash.js && cp GoogleService-Info.plist ios/ThriveChurchOfficialApp/",
    "generate:splash": "node scripts/generate-android-splash.js",
    "version:bump": "node scripts/increment-build.js",
    "version:patch": "node scripts/increment-build.js --bump-patch",
    "version:minor": "node scripts/increment-build.js --bump-minor",
    "version:major": "node scripts/increment-build.js --bump-major",
    "build:ios": "node scripts/increment-build.js && pnpm run prebuild:ios",
    "build:android": "node scripts/increment-build.js && pnpm run prebuild:android",
    "credentials:ci": "node scripts/write-production-credentials.js && node generate-firebase-configs.js",
    "eas:build:production": "eas build --platform all --profile production --non-interactive",
    "eas:release": "eas build --platform all --profile production --non-interactive --auto-submit",
    "test:ui": "./scripts/run-ui-tests.sh all",
    "test:ui:ios": "./scripts/run-ui-tests.sh ios",
    "test:ui:android": "./scripts/run-ui-tests.sh android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/analytics": "^27.1.1",
    "@react-native-firebase/app": "^27.1.1",
    "@react-native-firebase/crashlytics": "^27.1.1",
    "@react-native-firebase/messaging": "^27.1.1",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "@shopify/flash-list": "^2.3.2",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.20.0",
    "expo": "~58.0.26",
    "expo-application": "^58.1.2",
    "expo-build-properties": "^58.0.12",
    "expo-calendar": "~58.0.8",
    "expo-constants": "^58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-device": "^58.0.5",
    "expo-file-system": "^58.0.14",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.4",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-splash-screen": "^58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "^58.0.7",
    "i18next": "^25.6.0",
    "react": "19.3.0",
    "react-i18next": "^16.2.3",
    "react-native": "0.88.1",
    "react-native-audio-analyzer": "^4.0.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-rss-parser": "^1.5.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-share": "^12.3.1",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.13.0",
    "react-native-youtube-iframe": "^2.4.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.14"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "expo-doctor": "^1.21.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
